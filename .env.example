# CiteGrid Environment Configuration Example
# Copy this file to .env for local development

# Security
DEBUG=True
SECRET_KEY=django-insecure-citegrid-local-development-only-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Default: Local SQLite database for offline tests and zero-setup development
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (local daemon or containerized service):
# DATABASE_URL=postgres://citegrid:citegrid@localhost:5432/citegrid
